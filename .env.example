# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Google Cloud ---------------------------------------------------------
GOOGLE_CLOUD_PROJECT=relayops-fleet
# MUST be "global" — verified 2026-08-15 (F-1). Every Gemini >=3.5 model is
# listed by models.list() in us-central1 but 404s on generate_content there;
# they are served only on the global endpoint. gemini-2.5-* still works
# regionally, which is why relayops-prod never hit this. See GAP-014 for the
# data-residency consequence.
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true

# --- Models (verified callable 2026-08-15 by scripts/spike_f1.py) ---------
# Hackathon requires Gemini 3.5 or newer. NO Pro-tier model at >=3.5 exists on
# any accessible endpoint, so both tiers are flash: newest for the judgement
# call, older/cheaper for high-volume templated copy.
GEMINI_SEGMENT_MODEL=gemini-3.7-flash
GEMINI_OUTREACH_MODEL=gemini-3.5-flash

# --- Database -------------------------------------------------------------
# Local: docker-compose Postgres. Cloud: Cloud SQL via the connector (F-2).
DATABASE_URL=postgresql+psycopg://relayops:relayops@localhost:5434/relayops
CLOUD_SQL_INSTANCE=

# --- Async fabric (F-6) ---------------------------------------------------
PUBSUB_TOPIC_CAMPAIGN_RUN=relayops.campaign.run
PUBSUB_SUBSCRIPTION_CAMPAIGN_RUN=relayops.campaign.run.worker
PUBSUB_DLQ_TOPIC=relayops.campaign.run.dlq

# --- Cost caps (never run uncapped; dry-run is the default) ---------------
SEGMENT_MAX_CLIENTS=25
OUTREACH_MAX_DRAFTS=25
DRY_RUN=true

# --- Compliance gates (F-4) ----------------------------------------------
CONTACT_COOLDOWN_DAYS=14
ATTRIBUTION_WINDOW_DAYS=30
SHOW_FEE_CENTS=5000
FEE_CAP_CENTS=150000

# --- Operator dashboard (F-8) --------------------------------------------
DASHBOARD_PASSWORD=
PUBLIC_BASE_URL=

# --- Model Armor (F-9) ----------------------------------------------------
# Full resource name. When unset, the deterministic screen in
# core/untrusted.py stands alone — which is correct for a local run, not a
# silent downgrade. When set but unreachable, notes are DROPPED, never passed
# through unscreened.
MODEL_ARMOR_TEMPLATE=projects/relayops-fleet/locations/us-central1/templates/relayops-notes

# --- Agent Engine Memory Bank (F-9.3) -------------------------------------
# The Agent Engine instance that holds per-clinic campaign memory. Created
# by deploy.sh step 4b as a bare instance with no agent code — it exists
# only to hold memories. Its location is regional and deliberately NOT the
# Vertex location above: Agent Engine lives in a region, Gemini >=3.5 is
# served from `global`. Leave blank to run without memory, which records a
# verdict of 'absent' rather than failing.
AGENT_ENGINE_ID=4936571363470082048
AGENT_ENGINE_LOCATION=us-central1
